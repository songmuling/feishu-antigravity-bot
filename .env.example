# ===================================================
# 飞书机器人配置 (Feishu / Lark Bot Configuration)
# 登录飞书开放平台 (open.feishu.cn) -> 创建企业自建应用
# ===================================================

# 凭据与基础信息 -> 凭据 -> App ID
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx

# 凭据与基础信息 -> 凭据 -> App Secret
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===================================================
# 可选高级配置 (Optional Advanced Configurations)
# ===================================================

# Antigravity CLI 可执行程序绝对路径 (默认: /root/.gemini/bin/agy)
# AGY_BIN=/root/.gemini/bin/agy

# 会话数据持久化存储路径 (默认: ./sessions.json)
# SESSIONS_FILE=./sessions.json
